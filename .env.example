# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is listed in .gitignore and must never be shared, committed or pasted
# into a chat. It is the only place secrets live.

# ---------------------------------------------------------------------------
# Broker login (Kotak Neo). Get these from the Kotak Neo API portal.
# If you use a different broker, see BROKERS.md - these names change with it.
# ---------------------------------------------------------------------------
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=

# Optional. The base32 secret behind your authenticator QR code. With it the app
# makes its own 6-digit code and can start unattended; without it you type the
# code in each morning.
KOTAK_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Telegram alerts (optional, strongly recommended before any real money).
# Run: python3 setup_telegram.py  - it fills these two in for you.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# The master safety switch. While this is false the app can run in Demo and
# Paper mode only, and no order can reach the exchange however the dashboard is
# set. Leave it false until months of paper evidence say otherwise.
# ---------------------------------------------------------------------------
LIVE_TRADING=false
